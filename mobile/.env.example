EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional: raises the USDA food search rate limit
EXPO_PUBLIC_FDC_API_KEY=DEMO_KEY

# Vitto Plus through the App Store (see PAYMENTS.md). Leave unset to keep test purchases.
# RevenueCat's public iOS SDK key (starts with appl_). Public by design.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
# Shown on the paywall, as the App Store requires. Terms defaults to Apple's standard licence.
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
# Where the sign-up confirmation email lands (also add it to Supabase Auth > URL Configuration).
EXPO_PUBLIC_EMAIL_CONFIRMED_URL=
