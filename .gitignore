node_modules/
dist/
.env
.env.local
supabase/.temp/
/ios/

# The standalone AI companion prototype: its own git repo, its own secrets and a
# 1 GB node_modules. Its character logic has been ported into packages/core and
# supabase/functions/companion; the folder stays local as reference only.
/vittoAI/

# Generated into the widget target by @bacons/apple-targets on every prebuild,
# from expo-target.config.js and sprites/. The sprites themselves are committed.
/mobile/targets/*/Assets.xcassets/
/mobile/targets/*/Info.plist

# The music as it arrived: uncompressed, ~180 MB. The app ships the AAC
# conversions beside them (lofi-N.m4a); these are kept locally as the masters.
/mobile/assets/music/*.wav

# QA screenshots and logs: local only, regenerated by the QA agents.
/qa-artifacts/
