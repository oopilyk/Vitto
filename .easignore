# What `eas build` leaves out of the upload.
#
# While this file exists EAS reads it INSTEAD of every .gitignore in the repo,
# so the rules from all of them are repeated below. Keep them in step: a rule
# dropped here means that file gets uploaded (and .env.local holds secrets).

# --- from /.gitignore -------------------------------------------------------
node_modules/
dist/
.env
.env.local
supabase/.temp/
/ios/
/vittoAI/
/mobile/targets/*/Assets.xcassets/
/mobile/targets/*/Info.plist
/mobile/assets/music/*.wav
/qa-artifacts/

# --- from /mobile/.gitignore ------------------------------------------------
.expo/
web-build/
expo-env.d.ts
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store
*.pem
.env*.local
*.tsbuildinfo
/mobile/ios
/mobile/android

# --- from /packages/core/.gitignore -----------------------------------------
/packages/core/scripts/.wordlist-cache/

# --- not needed to build the app --------------------------------------------
# Original art and video the shipped assets were made from; the app never loads them.
/mobile/assets/source/
# The web app: only its package.json is needed, for the workspace install.
/web/*
!/web/package.json
# Backend, evals, QA and tooling.
/supabase/
/evals/
/qa/
/.claude/
